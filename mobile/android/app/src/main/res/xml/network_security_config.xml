<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system certificate authorities only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Debug builds also trust user-installed CAs so traffic can be inspected with a proxy. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
