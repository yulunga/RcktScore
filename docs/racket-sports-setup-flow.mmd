    class A,LIVE startEnd;
    class TT,BM,PB,NA,HIDDEN unavailable;
    class D,TN,ACCESS,ACCOUNT,LINEUP,RULES,HC,HCM,WHEN,PLAN,FREE,BUSY,PREPLAY,TIMER,WSPORT decision;
